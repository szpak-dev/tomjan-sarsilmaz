---
import { translationRepository } from "../content";
import type { SpecificationItem } from "../content/product.repository";
import ProductSection from "./ProductSection.astro";
import AttributeGroup from "./AttributeGroup.astro";

export type Props = {
  specification: SpecificationItem[];
  lang: string;
};

const { specification, lang } = Astro.props;
const t = translationRepository.getTranslator(lang);
---

<ProductSection heading={t("headings.specification")}>
  <AttributeGroup attributes={specification} />
</ProductSection>
