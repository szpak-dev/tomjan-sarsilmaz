---
import { translationRepository } from "../content";
import ProductSection from "./ProductSection.astro";

export type Props = {
  description: string[];
  lang: string;
};

const { description, lang } = Astro.props;
const t = translationRepository.getTranslator(lang);
---

<ProductSection heading={t("headings.description")}>
  <div class="vstack gap-3">
    {description.map((paragraph) => (
      <p class="mb-0">{paragraph}</p>
    ))}
  </div>
</ProductSection>
