---
import { CldImage } from "astro-cloudinary";
import { Badge } from "astro-bootstrap";

import type { Product } from "../content/product.repository";

export type Props = {
  product: Product;
};

const { product } = Astro.props;

const caliber = product.attribute_groups
  .find((group) => group.id === "specification")
  ?.properties.find((prop) => prop.id === "caliber")?.value || product.name_short;

const color = product.variants.find((variant) => variant.id === "color")?.value || "";

const image = product.images[0];
---

<div class="card h-100 shadow-sm border-light rounded-0">
  <CldImage
    class={"card-img-top rounded-0 object-fit-contain"}
    crop="pad"
    width={400}
    height={300}
    src={image}
    alt={product.name}
  />
  <div class="card-body d-flex flex-column">
    <h5 class="card-title text-truncate h6 m-0" title={product.name}>
      {product.name_short}
    </h5>
    <small class="text-truncate text-secondary d-flex justify-content-between align-items-center">
      <span>{color}</span>
      <Badge variant="light">{caliber}</Badge>
    </small>
    <a href={product.link} class="mt-auto stretched-link"></a>
  </div>
</div>
