---
import { translationRepository } from "../content";
import type { Manufacturer } from "../content/manufacturer.repository";
import ManufacturerLogo from "./ManufacturerLogo.astro";

export type Props = {
    lang: string;
    manufacturer: Manufacturer;
}

const { lang, manufacturer } = Astro.props;

const t = translationRepository.getTranslator(lang);
---

<section class="row">
    <div class="col-md-6 d-flex flex-column justify-content-center align-items-center">
        <h2 class="h5 fw-bold">{t('frontpage.distributor')}</h2>
        <p class="text-secondary">{t('frontpage.distributorSlogan')}</p>
    </div>
    <div class="col-md-6 d-flex flex-column justify-content-center align-items-center">
        <ManufacturerLogo manufacturer={manufacturer} />
    </div>
</section>