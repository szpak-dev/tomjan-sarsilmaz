---
import { translationRepository } from "../content";
import type { Feature } from "../content/product.repository";
import AttributeGroup from "./AttributeGroup.astro";
import ProductSection from "./ProductSection.astro";

export type Props = {
  features: Feature[];
  lang: string;
};

const { features, lang } = Astro.props;
const t = translationRepository.getTranslator(lang);
---
<ProductSection heading={t("headings.features")}>
  <div class="vstack gap-3 px-4">
    {
      features.map((feature) => (
        <AttributeGroup
          title={feature.category}
          titleClass="fs-5 text-secondary"
          attributes={feature.parameters}
          attributesClass="px-3"
        />
      ))
    }
  </div>
</ProductSection>
