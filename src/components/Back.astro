---
import { getLocaleUrl } from "../libs/url";

export type Props = {
  targetPath?: string;
  label?: string;
  className?: string;
};

const { targetPath = "", label, className = "my-4" } = Astro.props;

const backUrl = getLocaleUrl(
  Astro.url.pathname, 
  Astro.currentLocale as string, 
  Astro.currentLocale as string, 
  targetPath
);
---

<div class={className}>
  <a class="btn btn-outline-secondary border-0 m-0" href={backUrl}>
    <i class="bi bi-arrow-left-circle me-2"></i>
    <span>{label || ""}</span>
  </a>
</div>
