---
import { getLocaleUrl } from "../libs/url";
import { translationRepository } from "../content";

const languages = translationRepository.findAvailableLanguages();
const currentLang = translationRepository.getLanguage(
  Astro.currentLocale as string
);
---

<div class="dropdown d-inline-block ms-3">
  <button
    class="btn btn-outline-secondary dropdown-toggle btn-sm"
    type="button"
    data-bs-toggle="dropdown"
    aria-expanded="false"
  >
    {currentLang.flag}
  </button>
  <ul class="dropdown-menu">
    {
      languages.map(({ code, label, flag }) => (
        <li>
          <a
            class="dropdown-item"
            href={getLocaleUrl(Astro.url.pathname, Astro.currentLocale as string, code)}
          >
            {flag}
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
