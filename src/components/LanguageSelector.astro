---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getBasePath } from "../libs/deployment";
import { translationRepository } from "../content";

const languages = translationRepository.findAvailableLanguages();
const currentLang = translationRepository.getLanguage(
  Astro.currentLocale as string
);

const basePath = getBasePath();
const pathname = Astro.url.pathname;

let currentPath = pathname.startsWith(basePath) 
  ? pathname.slice(basePath.length)
  : pathname;

const localePrefix = `/${Astro.currentLocale}/`;
currentPath = currentPath.startsWith(localePrefix)
  ? currentPath.slice(localePrefix.length)
  : currentPath;
---

<div class="dropdown d-inline-block ms-3">
  <button
    class="btn btn-outline-secondary dropdown-toggle btn-sm"
    type="button"
    data-bs-toggle="dropdown"
    aria-expanded="false"
  >
    {currentLang.flag}
  </button>
  <ul class="dropdown-menu">
    {
      languages.map(({ code, label, flag }) => (
        <li>
          <a
            class="dropdown-item"
            href={getRelativeLocaleUrl(code, currentPath)}
          >
            {flag}
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
