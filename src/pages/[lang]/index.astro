---
import Layout from "../../layouts/Layout.astro";
import FrontPageSlider from "../../components/FrontPageSlider.astro";
import ProductCard from "../../components/ProductCard.astro";
import { translationRepository, productRepository } from "../../content";
import FrontPageSection from "../../components/FrontPageSection.astro";

export async function getStaticPaths() {
  return translationRepository.findAvailableLanguages().map((lang) => ({
    params: { lang: lang.code },
    props: {},
  }));
}

const lang = Astro.currentLocale as string;
const t = translationRepository.getTranslator(lang);

const products = await productRepository.findProducts(lang);
const featuredProducts = products.filter((product) => product.featured);
const activeProducts = products.filter((product) => product.active);
---

<Layout title={t("meta.title")}>
  <section id="promotedProductSlider" class="row">
    <FrontPageSlider products={featuredProducts} />
  </section>
  
  <FrontPageSection heading={t("headings.products")}>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      {activeProducts.map((product) => {
        return (
          <div class="col">
            <ProductCard product={product} />
          </div>
        )
      })}
    </div>
  </FrontPageSection>
</Layout>
